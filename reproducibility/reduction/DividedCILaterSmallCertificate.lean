theorem endpoint_certificate :
    rows.all (fun r => decide (0 ≤ 10000000000000000*r.1+
      (if 0 ≤ r.2 then 16180339887498948*r.2 else 16180339887498949*r.2))) = true := by
  decide

theorem golden_fine_interval (p : ℝ) (hp : 1 ≤ p) (hroot : p^2=p+1) :
    16180339887498948/10000000000000000 < p ∧ p < 16180339887498949/10000000000000000 := by
  constructor
  · by_contra hn
    have h1 : 0 ≤ 16180339887498948/10000000000000000-p := by linarith only [hn]
    have h2 : 0 ≤ 16180339887498948/10000000000000000+p-1 := by linarith only [hp]
    have hprod:=mul_nonneg h1 h2
    nlinarith only [hprod,hroot]
  · by_contra hn
    have h1 : 0 ≤ p-16180339887498949/10000000000000000 := by linarith only [hn]
    have h2 : 0 ≤ p+16180339887498949/10000000000000000-1 := by linarith only [hp]
    have hprod:=mul_nonneg h1 h2
    nlinarith only [hprod,hroot]

theorem all_scalar_margins (p : ℝ)
    (hlo : 16180339887498948/10000000000000000 ≤ p) (hhi : p ≤ 16180339887498949/10000000000000000) :
    ∀ r ∈ rows, 0 ≤ (r.1:ℝ)+(r.2:ℝ)*p := by
  intro r hr
  have hend:=of_decide_eq_true (List.all_eq_true.mp endpoint_certificate r hr)
  by_cases hb : 0 ≤ r.2
  · simp only [hb, ite_true] at hend
    have hendR : (0:ℝ) ≤ 10000000000000000*(r.1:ℝ)+16180339887498948*(r.2:ℝ) := by exact_mod_cast hend
    have hbR : (0:ℝ) ≤ (r.2:ℝ) := by exact_mod_cast hb
    have hprod:=mul_nonneg hbR (show 0 ≤ p-16180339887498948/10000000000000000 by linarith only [hlo])
    nlinarith only [hendR,hprod]
  · simp only [hb, ite_false] at hend
    have hendR : (0:ℝ) ≤ 10000000000000000*(r.1:ℝ)+16180339887498949*(r.2:ℝ) := by exact_mod_cast hend
    have hbR : (r.2:ℝ) ≤ 0 := by exact_mod_cast (le_of_lt (lt_of_not_ge hb))
    have hprod:=mul_nonneg (show 0 ≤ -(r.2:ℝ) by linarith only [hbR])
      (show 0 ≤ 16180339887498949/10000000000000000-p by linarith only [hhi])
    nlinarith only [hendR,hprod]

