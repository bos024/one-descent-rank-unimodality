theorem exact_pure_three_six_base (q : ℝ) (hq : q^2+q=1)
    (hlo : 618033988/1000000000 ≤ q) (hhi : q ≤ 618033989/1000000000) :
    0 < ((1:ℝ)+(0:ℝ)*q) ∧
    0 < ((6:ℝ)+(-1:ℝ)*q) ∧
    0 < ((22:ℝ)+(-7:ℝ)*q) ∧
    0 < ((57:ℝ)+(-29:ℝ)*q) ∧
    0 < ((119:ℝ)+(-86:ℝ)*q) ∧
    0 < ((212:ℝ)+(-205:ℝ)*q) ∧
    0 < ((346:ℝ)+(-417:ℝ)*q) ∧
    0 < ((543:ℝ)+(-763:ℝ)*q) ∧
    0 < ((853:ℝ)+(-1306:ℝ)*q) ∧
    0 < ((1356:ℝ)+(-2159:ℝ)*q) ∧
    0 < ((2180:ℝ)+(-3515:ℝ)*q) ∧
    0 < ((3521:ℝ)+(-5695:ℝ)*q) ∧
    0 < ((5696:ℝ)+(-9216:ℝ)*q) ∧
    ((1:ℝ)+(0:ℝ)*q)*((22:ℝ)+(-7:ℝ)*q) ≤ ((6:ℝ)+(-1:ℝ)*q)^2 ∧
    ((6:ℝ)+(-1:ℝ)*q)*((57:ℝ)+(-29:ℝ)*q) ≤ ((22:ℝ)+(-7:ℝ)*q)^2 ∧
    ((22:ℝ)+(-7:ℝ)*q)*((119:ℝ)+(-86:ℝ)*q) ≤ ((57:ℝ)+(-29:ℝ)*q)^2 ∧
    ((57:ℝ)+(-29:ℝ)*q)*((212:ℝ)+(-205:ℝ)*q) ≤ ((119:ℝ)+(-86:ℝ)*q)^2 ∧
    ((119:ℝ)+(-86:ℝ)*q)*((346:ℝ)+(-417:ℝ)*q) ≤ ((212:ℝ)+(-205:ℝ)*q)^2 ∧
    ((212:ℝ)+(-205:ℝ)*q)*((543:ℝ)+(-763:ℝ)*q) ≤ ((346:ℝ)+(-417:ℝ)*q)^2 ∧
    ((346:ℝ)+(-417:ℝ)*q)*((853:ℝ)+(-1306:ℝ)*q) ≤ ((543:ℝ)+(-763:ℝ)*q)^2 ∧
    ((543:ℝ)+(-763:ℝ)*q)*((1356:ℝ)+(-2159:ℝ)*q) ≤ ((853:ℝ)+(-1306:ℝ)*q)^2 ∧
    ((853:ℝ)+(-1306:ℝ)*q)*((2180:ℝ)+(-3515:ℝ)*q) ≤ ((1356:ℝ)+(-2159:ℝ)*q)^2 ∧
    ((1356:ℝ)+(-2159:ℝ)*q)*((3521:ℝ)+(-5695:ℝ)*q) ≤ ((2180:ℝ)+(-3515:ℝ)*q)^2 ∧
    ((2180:ℝ)+(-3515:ℝ)*q)*((5696:ℝ)+(-9216:ℝ)*q) ≤ ((3521:ℝ)+(-5695:ℝ)*q)^2 ∧
    2*(1+q+6*q)*((5696:ℝ)+(-9216:ℝ)*q) ≤ (1+q)^2 := by
  refine ⟨?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_ , ?_⟩ <;> nlinarith [hq]
